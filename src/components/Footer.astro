---
/**
 * Site footer — Brand Kit v3 Pushpin Tear Footer.
 * Deep Violet (#1E1640) poster sheet + glossy Ember (#FF6A2B) pushpin ripping
 * away to reveal Lavender Mist (#F3F0FC) paper printed with Ink (#120E24).
 */
import PushpinTearFooter from './ui/pushpin-tear-footer.tsx';

export interface Props {
    copyright?: string;
    links?: { label: string; href: string }[];
}

const currentYear = new Date().getFullYear();
const { copyright = `© ${currentYear} Mikey Shaw` } = Astro.props;
---

<div class="ms-tear-footer-host">
    <PushpinTearFooter
        client:only="react"
        copyright={copyright}
    />
</div>

<style>
    .ms-tear-footer-host {
        position: relative;
        z-index: 1;
        width: 100%;
    }
</style>
