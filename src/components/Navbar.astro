---
import MikeyLogo from './MikeyLogo.astro';
import ThemeToggle from './ThemeToggle.astro';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const navLinks = [
    { name: 'Summary', href: isHome ? '#summary' : '/#summary', id: '01' },
    { name: 'Skills', href: isHome ? '#capabilities' : '/#capabilities', id: '02' },
    { name: 'AI Assessment', href: '/assessment', id: '03' },
    { name: 'Agent Fleet', href: '/fleet', id: '04' },
    { name: 'AI Kit', href: '/starter-kit', id: '05' },
    { name: 'Resume', href: '/resume', id: '06' }
];

const ctaHref = isHome ? '#contact' : '/#contact';
---

<nav class="ms-header" aria-label="Main">
    <!-- Logo: plain A pinwheel + MIKEY SHAW lockup (kit v3) -->
    <a class="ms-header__home" aria-label="Mikey Shaw, home" href="/">
        <MikeyLogo size={14} />
    </a>

    <!-- Desktop Navigation Menu -->
    <div class="ms-header__links">
        {navLinks.map((link) => (
            <a class="ms-header__link" href={link.href} data-nav-link>
                <span class="ms-header__num" aria-hidden="true">{link.id}</span> {link.name}
            </a>
        ))}
    </div>

    <div class="ms-header__actions">
        <ThemeToggle />
        <a class="ms-btn ms-header__cta" href={ctaHref}>Schedule Call</a>

        <!-- Mobile Navigation Toggle -->
        <button
            class="ms-header__burger"
            id="mobile-menu-toggle"
            aria-label="Toggle Navigation Menu"
            aria-expanded="false"
            aria-controls="mobile-drawer"
        >
            <span class="ms-bar" id="bar-1"></span>
            <span class="ms-bar ms-bar--short" id="bar-2"></span>
            <span class="ms-bar ms-bar--mid" id="bar-3"></span>
        </button>
    </div>
</nav>

<!-- Mobile Drawer Overlay (outside <nav> to avoid the z-index trap) -->
<div
    class="ms-drawer pointer-events-none invisible"
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation Menu"
>
    <div class="ms-drawer__inner">
        {navLinks.map((link) => (
            <a class="ms-drawer__link" href={link.href} data-mobile-nav-link>
                <span class="ms-drawer__num" aria-hidden="true">{link.id}</span>
                {link.name}
            </a>
        ))}
        <div class="ms-drawer__rule"></div>
        <a class="ms-btn ms-drawer__cta" href={ctaHref} data-mobile-nav-link>Schedule Call</a>
    </div>
</div>

<script>
    function initNavbar() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const drawer = document.getElementById('mobile-drawer');
        const bar1 = document.getElementById('bar-1');
        const bar2 = document.getElementById('bar-2');
        const bar3 = document.getElementById('bar-3');
        const mobileLinks = document.querySelectorAll('[data-mobile-nav-link]');
        const desktopLinks = document.querySelectorAll('[data-nav-link]');

        if (!toggleBtn || !drawer) return;

        let isOpen = false;

        function toggleMenu() {
            isOpen = !isOpen;
            toggleBtn?.setAttribute('aria-expanded', String(isOpen));
            
            if (isOpen) {
                // Show Drawer
                drawer?.classList.remove('pointer-events-none', 'invisible');
                drawer?.classList.add('opacity-100', 'visible');
                
                // Animate Hamburger to 'X'
                if (bar1) {
                    bar1.style.transform = 'translateY(7px) rotate(45deg)';
                    bar1.style.width = '24px';
                }
                if (bar2) bar2.style.opacity = '0';
                if (bar3) {
                    bar3.style.transform = 'translateY(-7px) rotate(-45deg)';
                    bar3.style.width = '24px';
                }
            } else {
                // Hide Drawer
                drawer?.classList.add('pointer-events-none', 'invisible');
                drawer?.classList.remove('opacity-100', 'visible');
                
                // Animate 'X' back to Hamburger
                if (bar1) {
                    bar1.style.transform = 'none';
                    bar1.style.width = '24px';
                }
                if (bar2) bar2.style.opacity = '1';
                if (bar3) {
                    bar3.style.transform = 'none';
                    bar3.style.width = '20px';
                }
            }
        }

        toggleBtn.addEventListener('click', toggleMenu);

        // Close drawer on link clicks
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (isOpen) toggleMenu();
            });
        });

        // Smooth scroll for hash links on the same page
        function smoothScroll(e: Event) {
            const currentTarget = e.currentTarget as HTMLAnchorElement;
            const href = currentTarget.getAttribute('href') || '';
            
            // Check if it's a hash link for the current page
            if (href.startsWith('#')) {
                e.preventDefault();
                const targetEl = document.querySelector(href);
                if (targetEl) {
                    targetEl.scrollIntoView({ behavior: 'smooth' });
                }
            } else if (href.startsWith('/#')) {
                // If on homepage, strip the '/' and smooth scroll
                if (window.location.pathname === '/' || window.location.pathname === '') {
                    e.preventDefault();
                    const hash = href.substring(1);
                    const targetEl = document.querySelector(hash);
                    if (targetEl) {
                        targetEl.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            }
        }

        desktopLinks.forEach(link => link.addEventListener('click', smoothScroll));
        mobileLinks.forEach(link => link.addEventListener('click', smoothScroll));
    }

    // Initialize
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initNavbar);
    } else {
        initNavbar();
    }
    
    // Support Astro View Transitions
    document.addEventListener('astro:page-load', initNavbar);
</script>

<style>
    .ms-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 72px;
        padding: 12px max(16px, env(safe-area-inset-right)) 12px max(16px, env(safe-area-inset-left));
        background: var(--ms-header-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--ms-border);
        color: var(--ms-text);
    }
    @media (min-width: 768px) {
        .ms-header { padding-left: 40px; padding-right: 40px; }
    }
    .ms-header__home {
        display: inline-flex;
        align-items: center;
        min-height: var(--ms-tap);
        color: var(--ms-text);
        text-decoration: none;
        flex: none;
    }
    .ms-header__links {
        display: none;
        align-items: center;
        gap: 4px;
    }
    @media (min-width: 1100px) {
        .ms-header__links { display: flex; }
    }
    .ms-header__link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: var(--ms-tap);
        padding: 0 10px;
        border-radius: var(--ms-r-button);
        font: 700 0.6875rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ms-muted);
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s var(--ms-ease);
    }
    .ms-header__link:hover { color: var(--ms-text); }
    .ms-header__num { color: var(--ms-accent-text); }
    .ms-header__actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ms-header__cta { display: none; }
    @media (min-width: 1100px) {
        .ms-header__cta { display: inline-flex; }
    }
    .ms-header__burger {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
        gap: 6px;
        width: var(--ms-tap);
        height: var(--ms-tap);
        padding: 0 10px;
        background: transparent;
        border: 1px solid var(--ms-border);
        border-radius: var(--ms-r-button);
        color: var(--ms-text);
        cursor: pointer;
        position: relative;
        z-index: 55;
    }
    @media (min-width: 1100px) {
        .ms-header__burger { display: none; }
    }
    .ms-bar {
        display: block;
        width: 24px;
        height: 2px;
        background: currentColor;
        transform-origin: center;
        transition: transform 0.3s var(--ms-ease), opacity 0.3s var(--ms-ease), width 0.3s var(--ms-ease);
    }
    .ms-bar--short { width: 16px; }
    .ms-bar--mid { width: 20px; }

    .ms-drawer {
        position: fixed;
        inset: 0;
        z-index: 54;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 96px max(24px, env(safe-area-inset-left)) 40px;
        background: var(--ms-ground);
        color: var(--ms-text);
        overflow-y: auto;
        opacity: 0;
        transition: opacity 0.4s var(--ms-ease);
    }
    .ms-drawer.opacity-100 { opacity: 1; }
    @media (min-width: 1100px) {
        .ms-drawer { display: none; }
    }
    .ms-drawer__inner {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .ms-drawer__link {
        display: flex;
        align-items: baseline;
        gap: 16px;
        min-height: var(--ms-tap);
        padding: 6px 0;
        font: 900 clamp(1.75rem, 7vw, 2.25rem)/1.1 var(--ms-font-head);
        color: var(--ms-text);
        text-decoration: none;
    }
    .ms-drawer__link:hover { color: var(--ms-accent-text); }
    .ms-drawer__num {
        font: 700 0.8125rem/1 var(--ms-font-mono);
        letter-spacing: 0.2em;
        color: var(--ms-accent-text);
    }
    .ms-drawer__rule {
        height: 1px;
        background: var(--ms-border);
        margin: 16px 0;
    }
    .ms-drawer__cta { min-height: 54px; }
</style>
