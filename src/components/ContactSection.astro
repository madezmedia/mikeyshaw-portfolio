---
import LetsWorkTogether from './ui/lets-work-section.tsx';
import SocialIcons from './ui/social-icons.tsx';
import MikeyBooking from './MikeyBooking.tsx';

const directChannels = [
    {
        label: 'Email',
        value: 'michael@madezmedia.com',
        href: 'mailto:michael@madezmedia.com',
        note: 'Direct inquiries & proposal reviews',
    },
    {
        label: 'LinkedIn',
        value: 'in/michael-shaw-clt',
        href: 'https://www.linkedin.com/in/michael-shaw-clt/',
        note: 'Fractional CTO & systems updates',
    },
    {
        label: 'GitHub',
        value: 'github.com/madezmedia',
        href: 'https://github.com/madezmedia',
        note: 'LogMem, agent kits & production code',
    },
];
---

<section id="contact" class="ms-contact-section">
    <!-- 1. Interactive CTA Header -->
    <div class="ms-contact-hero">
        <LetsWorkTogether client:load />
    </div>

    <!-- 2. Mobile-Optimized Custom Cal.com Scheduler with Limited Windows -->
    <div class="ms-contact-scheduler">
        <MikeyBooking client:only="react" compactHeading={true} />
    </div>

    <!-- 3. Direct Channels & Social Dock -->
    <div class="ms-contact-footer">
        <div class="ms-direct-grid">
            {directChannels.map((ch) => {
                const isExternal = !ch.href.startsWith('mailto:');
                return (
                    <a
                        href={ch.href}
                        target={isExternal ? '_blank' : undefined}
                        rel={isExternal ? 'noopener noreferrer' : undefined}
                        class="ms-direct-card"
                    >
                        <span class="ms-direct-label">{ch.label}</span>
                        <strong class="ms-direct-value">{ch.value}</strong>
                        <span class="ms-direct-note">{ch.note}</span>
                    </a>
                );
            })}
        </div>

        <div class="ms-social-dock-wrap">
            <span class="ms-social-dock-label">Follow &amp; Connect</span>
            <SocialIcons client:load />
        </div>
    </div>
</section>

<style>
    .ms-contact-section {
        max-width: 1280px;
        width: 100%;
        min-width: 0;
        overflow-x: clip;
        margin: 0 auto;
        padding: clamp(1.5rem, 3vw, 2.75rem);
        background: var(--ms-ground);
        border: 1px solid var(--ms-border);
        border-radius: var(--ms-r-card);
    }

    .ms-contact-hero {
        border-bottom: 1px solid var(--ms-border);
        margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    }

    .ms-contact-scheduler {
        width: 100%;
        min-width: 0;
        overflow-x: clip;
    }

    .ms-contact-footer {
        margin-top: clamp(2rem, 4vw, 3rem);
        padding-top: clamp(1.5rem, 3vw, 2.25rem);
        border-top: 1px solid var(--ms-border);
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .ms-direct-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .ms-direct-card {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem 1.15rem;
        min-height: 44px;
        border-radius: var(--ms-r-window);
        border: 1px solid var(--ms-border);
        background: var(--ms-surface);
        text-decoration: none;
        transition: transform 0.2s var(--ms-ease), border-color 0.2s var(--ms-ease);
    }

    .ms-direct-card:hover {
        transform: translateY(-2px);
        border-color: var(--ms-ember);
    }

    .ms-direct-label {
        font: 700 0.6875rem/1.3 var(--ms-font-mono);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ms-accent-text);
    }

    .ms-direct-value {
        font: 700 0.95rem/1.3 var(--ms-font-body);
        color: var(--ms-text);
        word-break: break-word;
    }

    .ms-direct-note {
        font: 500 0.8rem/1.4 var(--ms-font-body);
        color: var(--ms-muted);
    }

    .ms-social-dock-wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.25rem;
    }

    .ms-social-dock-label {
        font: 700 0.7rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ms-muted);
    }

    @media (max-width: 840px) {
        .ms-direct-grid {
            grid-template-columns: 1fr;
        }
        .ms-social-dock-wrap {
            justify-content: center;
            flex-direction: column;
        }
    }

    @media (max-width: 640px) {
        .ms-contact-section {
            padding: 1.15rem;
            border-radius: 14px;
        }
    }
</style>
