---
import { ViewTransitions } from 'astro:transitions';
import ChatWidget from '../components/ChatWidget.tsx';
import ParticleBackground from '../components/ParticleBackground.astro';
import '../styles/animations.css';
import '../styles/mobile.css';
import '../styles/global.css';
import { UX_CONFIG } from '../utils/ux';

export interface Props {
	title?: string;
	description?: string;
	keywords?: string[];
	author?: string;
	ogImage?: string;
}

const { 
	title = "Michael Shaw | Digital Architect & AI Innovator", 
	description = "Michael Shaw: A visionary Digital Architect specializing in AI, automation, and innovative technology solutions. Transforming complex challenges into intelligent systems.",
	keywords = [
		"Michael Shaw", 
		"Digital Architect", 
		"AI Specialist", 
		"Technology Innovation", 
		"Automation Expert", 
		"Machine Learning", 
		"Software Development", 
		"Mad EZ Media"
	],
	author = "Michael Shaw",
	ogImage = "/images/mikey-shaw.png"
} = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="var(--ms-inverse-fg)" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1E1640" media="(prefers-color-scheme: dark)" />

		<!-- Brand kit v3 fonts: Playfair Display 900 (+italic), Raleway 500/700/900, Roboto Mono 700 -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Theme: runs before paint. Follows the system, falls back to light,
		     and honours a saved choice from the header toggle. -->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var saved = null;
				try { saved = localStorage.getItem('ms-theme'); } catch (e) {}
				var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
				function resolve() {
					if (saved === 'light' || saved === 'dark') return saved;
					return mq && mq.matches ? 'dark' : 'light';
				}
				function apply(theme) {
					root.setAttribute('data-theme', theme);
					root.classList.toggle('dark', theme === 'dark');
					document.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: theme, duration: 0 } }));
				}
				apply(resolve());
				if (mq && mq.addEventListener) {
					mq.addEventListener('change', function () { if (!saved) apply(resolve()); });
				}
				window.msSetTheme = function (theme) {
					saved = theme;
					try { localStorage.setItem('ms-theme', theme); } catch (e) {}
					apply(theme);
				};
				// Re-apply after Astro view transitions swap the document.
				document.addEventListener('astro:after-swap', function () { apply(resolve()); });
			})();
		</script>

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		<meta name="keywords" content={keywords.join(", ")} />

		<!-- Open Graph / Social Media -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://mikeyshaw.work/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://mikeyshaw.work/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<!-- Structured Data: Organization -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Michael Shaw",
			"jobTitle": "Fractional CTO & AI Systems Architect",
			"url": "https://mikeyshaw.work",
			"image": "/images/mikey-shaw.png",
			"sameAs": [
				"https://www.linkedin.com/in/michael-shaw-clt/",
				"https://github.com/madezmedia",
				"https://www.facebook.com/profile.php?id=100088552065336"
			],
			"worksFor": {
				"@type": "Organization",
				"name": "Mad EZ Media Partners LLC"
			},
			"knowsAbout": [
				"AI Agents",
				"Persistent Agent Memory",
				"Voice AI",
				"Automation",
				"Software Architecture"
			]
		}
		</script>

		<!-- Canonical Link -->
		<link rel="canonical" href="https://mikeyshaw.work" />
		<meta name="robots" content="index, follow" />

		<!-- Preload Critical Assets -->
		<link rel="preload" href="/images/mikey-shaw.png" as="image" />
		<link rel="preload" href="/favicon.svg" as="image" />

		<slot name="head" />

	</head>
	<body>
		<ParticleBackground />
		<div class="app-container">
			<div class="content-wrapper">
				<slot />
			</div>
		</div>
		<ChatWidget client:load />

		<script is:inline>
		// Snappy scroll interactions
		</script>
		
		<!-- Anime.js Integration for Micro-Interactions -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js" is:inline></script>
		<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduceMotion || typeof anime === 'undefined') {
				// Content is visible by default. Without motion, show reveal items at once.
				document.querySelectorAll('.reveal-item').forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
				return;
			}

			// 1. Spring micro-interactions for cards and buttons
			const springElements = document.querySelectorAll('.stagger-card, .tech-badge, nav button, nav a, .project-card, button, a.inline-block');
			
			springElements.forEach(el => {
				el.addEventListener('mouseenter', () => {
					anime({
						targets: el,
						scale: 1.03,
						translateY: -4,
						rotateZ: el.classList.contains('stagger-card') ? -0.5 : 0,
						duration: 400,
						easing: 'easeOutElastic(1.2, 0.6)'
					});
				});
				
				el.addEventListener('mouseleave', () => {
					anime({
						targets: el,
						scale: 1.0,
						translateY: 0,
						rotateZ: 0,
						duration: 300,
						easing: 'easeOutQuad'
					});
				});
			});

			// 2. Scroll-driven staggered entry reveals
			const sections = document.querySelectorAll('section');
			
			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						const items = entry.target.querySelectorAll('.reveal-item');
						if (items.length > 0) {
							anime({
								targets: items,
								opacity: [0, 1],
								translateY: [40, 0],
								delay: anime.stagger(120),
								duration: 800,
								easing: 'easeOutQuad'
							});
						}
						revealObserver.unobserve(entry.target);
					}
				});
			}, { threshold: 0.1 });

			sections.forEach(sec => {
				revealObserver.observe(sec);
			});
		});
		</script>
	</body>
</html>

<style define:vars={{
    transitionDuration: `${UX_CONFIG.TRANSITION_DURATION}ms`
}}>
    :root {
        /* Legacy layout variables, now pointed at kit v3 tokens (kit-v3.css) */
        /* --primary, --secondary and --accent come from global.css (shadcn roles). */
        --accent-yellow: var(--ms-accent-text);
        --accent-pink: var(--ms-accent-text);
        --accent-cyan: var(--ms-blue);
        --accent-purple: var(--ms-violet);
        --bg-primary: var(--ms-ground);
        --bg-secondary: var(--ms-surface);
        --text-primary: var(--ms-text);
        --text-secondary: var(--ms-muted);

        /* Layout Variables */
        --navbar-height: 80px;
        --content-top-padding: 100px;
    }

    html, body {
        max-width: 100%;
        overflow-x: hidden;
        scroll-behavior: smooth;
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }

    html {
        font-family: var(--ms-font-body);
        background: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.6;
    }

    body {
        background: transparent;
        color: var(--text-primary);
        margin: 0;
        padding: 0;
    }

    .app-container {
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 1;
        background: transparent;
        transition: all 0.3s ease;
    }

    .content-wrapper {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        flex-grow: 1;
    }

    /* First section after navbar gets top padding */
    .content-wrapper > section:first-child {
        padding-top: var(--content-top-padding);
    }

    /* Global Theme Transition - Removed for performance */
    /* * {
        transition: 
            background-color 0.3s ease,
            color 0.3s ease,
            border-color 0.3s ease,
            box-shadow 0.3s ease;
    } */

    @media (max-width: 768px) {
        :root {
            --content-top-padding: 80px;
        }

        .content-wrapper {
            padding: 0 0.5rem;
        }

        /* Ensure full-width components on mobile */
        .content-wrapper > section {
            width: 100%;
            margin: 0;
            padding: 1rem 0;
        }
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg-secondary);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--ms-border);
        border-radius: 0px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--ms-muted);
    }
</style>
