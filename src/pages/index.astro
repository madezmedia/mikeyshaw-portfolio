---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import BlogFeed from '../components/BlogFeed.astro';
import WindowFrameLog from '../components/WindowFrameLog.tsx';
import FractionalShowcase from '../components/FractionalShowcase.tsx';
import mikeyShaw from '../images/mikey-shaw.png';

const CALL = 'https://cal.com/mad-ez-media/ai-automation-discovery';

const running = [
    { name: 'LogMem', line: 'MIT-licensed, Redis-native shared memory for teams of AI agents.', href: 'https://logmem.si', cta: 'Visit logmem.si' },
    { name: 'Mad EZ Media', line: 'The 24/7 AI receptionist and growth systems for Charlotte trades.', href: 'https://madezmedia.com', cta: 'Visit Mad EZ' },
    { name: 'Folana', line: 'A creator media pipeline that runs on its own, every day.', href: 'https://github.com/madezmedia/folanas-journal', cta: 'View on GitHub' },
];

const keys = [
    { key: 'who', name: 'Who', line: 'The facts that stay put. Who the client is, what they bought, how they like to work.' },
    { key: 'now', name: 'Now', line: 'The current state, overwritten as it changes. What is open, what is blocked, what is next.' },
    { key: 'log', name: 'Log', line: 'Every step, in order, never edited. Who did what and when, so anyone can pick it up.' },
];
---

<Layout
    title="Mikey Shaw | Fractional CTO, Head of AI & AI Systems Architect"
    description="Operator first, technologist second. I build AI agent systems that answer, book, follow up, and remember using LogMem shared memory."
>
    <Navbar />

    <main class="w-full">
        <!-- 1. Hero -->
        <section class="home-hero max-w-[1440px] mx-auto px-6 md:px-[60px] pt-36 pb-20 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" id="hero">
            <div class="lg:col-span-7 reveal-item opacity-0">
                <div class="home-eyebrow">
                    <span class="num">N° 01</span>
                    <span>Fractional CTO · Head of AI · Charlotte, NC</span>
                </div>
                <h1 class="font-display-xl text-[clamp(2.6rem,5.6vw,4.9rem)] leading-[1.02] font-black tracking-tight text-[var(--ms-text)]">
                    Your AI agents should not start <br class="hidden md:block"/><em class="em-gradient font-black">from zero.</em>
                </h1>
                <p class="font-body-md text-lg text-[var(--ms-text)]/85 max-w-xl mt-8 leading-relaxed">
                    Operator first, technologist second. I build production AI agent systems that answer, book, follow up, and remember on shared memory in LogMem. I run them in production for my own companies before I ever sell them to yours.
                </p>
                <div class="flex flex-wrap gap-4 items-center mt-10">
                    <a class="ms-btn" href="#book-call">Book discovery call →</a>
                    <a class="home-btn-ghost" href="/fractional">Fractional CTO rate card</a>
                    <a class="home-link" href="/starter-kit">Get the free kit →</a>
                </div>
            </div>
            <div class="lg:col-span-5 reveal-item opacity-0 flex justify-center">
                <Image
                    src={mikeyShaw}
                    alt="Mikey Shaw, Fractional CTO and AI Systems Architect"
                    class="w-full max-w-md aspect-[4/5] object-cover grayscale contrast-115 brightness-95 hover:grayscale-0 transition-all duration-700 rounded-2xl border border-[var(--ms-border)]"
                    width={800}
                    height={1000}
                    format="avif"
                    quality="high"
                    loading="eager"
                />
            </div>
        </section>

        <!-- 2. Running now -->
        <section class="border-y border-[var(--ms-border)] bg-[var(--ms-surface)]" aria-labelledby="running-title">
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-10">
                <h2 id="running-title" class="home-label mb-6">Running in production</h2>
                <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none p-0 m-0">
                    {running.map((r) => (
                        <li class="flex flex-col gap-1">
                            <span class="font-headline font-extrabold text-[var(--ms-text)]">{r.name}</span>
                            <span class="font-sans text-sm text-[var(--ms-muted)] leading-relaxed">{r.line}</span>
                            <a class="home-link mt-1" href={r.href} target="_blank" rel="noopener noreferrer">{r.cta} →</a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- 3. The idea + Signature Kit v3 Window-Frame Log -->
        <section class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-24" id="idea">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
                <div class="lg:col-span-6 reveal-item opacity-0">
                    <div class="home-eyebrow"><span class="num">N° 02</span>The idea</div>
                    <h2 class="font-display-xl text-[clamp(2rem,4vw,3.25rem)] font-black tracking-tight leading-[1.06] text-[var(--ms-text)]">
                        Stop managing AI tools. Start running <em class="em-gradient font-black">systems.</em>
                    </h2>
                    <p class="font-body-md text-lg text-[var(--ms-text)]/80 mt-6 leading-relaxed">
                        Most AI forgets everything when the chat ends. You become the memory, the messenger, and the auditor for your own bots. Give every agent the same three keys and work passes cleanly without loss.
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
                        {keys.map((k) => (
                            <div class={`home-key home-key--${k.key}`}>
                                <span class="home-key__label">Key</span>
                                <h3 class="home-key__name">{k.name}</h3>
                                <p class="font-sans text-xs text-[var(--ms-muted)] leading-relaxed m-0">{k.line}</p>
                            </div>
                        ))}
                    </div>
                    <div class="flex flex-wrap gap-6 mt-8">
                        <a class="home-link" href="/starter-kit">Get the free kit →</a>
                        <a class="home-link" href="https://github.com/logmem/logmem" target="_blank" rel="noopener noreferrer">See LogMem on GitHub →</a>
                    </div>
                </div>

                <div class="lg:col-span-6 reveal-item opacity-0">
                    <WindowFrameLog />
                </div>
            </div>
        </section>

        <!-- 4. Interactive Audience Switcher: Fractional CTO / Head of AI + Operator Ladder + Proof Assets -->
        <section class="border-t border-[var(--ms-border)] bg-[var(--ms-surface)]" id="work-with-me">
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-24 reveal-item opacity-0">
                <FractionalShowcase client:load defaultAudience="fractional" callUrl={CALL} />
            </div>
        </section>

        <!-- 5. Writing -->
        <section class="px-6 md:px-[60px] py-24 border-t border-[var(--ms-border)]" id="intel">
            <div class="max-w-[1440px] mx-auto reveal-item opacity-0">
                <BlogFeed />
            </div>
        </section>

        <!-- 6. Contact -->
        <section class="px-6 md:px-[60px] py-24 bg-[var(--ms-surface)] border-t border-[var(--ms-border)]">
            <div class="max-w-[1440px] mx-auto reveal-item opacity-0">
                <ContactSection />
            </div>
        </section>

        <!-- 7. Kit v3 Cross-Link Door to Mad EZ Media (Safety Yellow ground, Ink text — 12.27:1 contrast) -->
        <a
            href="https://madezmedia.com"
            target="_blank"
            rel="noopener noreferrer"
            class="ms-door-band block border-t border-[var(--ms-ink)] no-underline transition-opacity hover:opacity-95"
        >
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-16 flex flex-wrap items-end justify-between gap-6">
                <div>
                    <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] block mb-2" style="color:#120E24">
                        Run a trade or local service business?
                    </span>
                    <strong class="ms-door-name block font-black italic leading-[0.95]" style="font-family:var(--ms-font-head);color:#120E24">
                        Mad EZ Media →
                    </strong>
                </div>
                <span class="font-sans text-base font-bold max-w-sm" style="color:#120E24">
                    24/7 AI receptionist, emergency triage, and dispatch builds for plumbers, HVAC, and electricians.
                </span>
            </div>
        </a>
    </main>

    <Footer
        copyright="© 2026 Mikey Shaw · Mad EZ Media Partners LLC."
        links={[
            { label: 'Fractional CTO', href: '/fractional' },
            { label: 'Mad EZ Media', href: 'https://madezmedia.com' },
            { label: 'LogMem', href: 'https://logmem.si' },
            { label: 'Resume', href: '/resume' },
        ]}
    />
</Layout>

<style>
    .home-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        font: 700 0.6875rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ms-accent-text);
    }
    .home-eyebrow .num { color: var(--ms-muted); }
    .em-gradient {
        font-style: italic;
        color: var(--ms-accent-text);
    }
    .home-label {
        font: 700 0.6875rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ms-muted);
    }
    .home-link {
        color: var(--ms-text);
        font-weight: 700;
        font-size: 0.875rem;
        text-decoration: underline;
        text-decoration-color: var(--ms-who);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }
    .home-link:hover { color: var(--ms-accent-text); }
    .home-link:focus-visible, .home-btn-ghost:focus-visible {
        outline: 3px solid var(--ms-focus);
        outline-offset: 3px;
        border-radius: 4px;
    }
    .home-btn-ghost {
        display: inline-flex;
        align-items: center;
        min-height: var(--ms-tap);
        padding: 0 22px;
        border-radius: var(--ms-r-button);
        border: 2px solid var(--ms-text);
        color: var(--ms-text);
        font: 700 0.8125rem/1 var(--ms-font-body);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s var(--ms-ease);
    }
    .home-btn-ghost:hover { background: var(--ms-surface); }

    .home-key {
        background: var(--ms-ground);
        border: 1px solid var(--ms-border);
        border-top: 4px solid var(--key);
        border-radius: var(--ms-r-card);
        padding: 18px;
    }
    .home-key--who { --key: var(--ms-who); --key-text: var(--ms-who-text); }
    .home-key--now { --key: var(--ms-now); --key-text: var(--ms-now-text); }
    .home-key--log { --key: var(--ms-log); --key-text: var(--ms-log-text); }
    .home-key__label {
        font: 700 0.625rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--key-text);
    }
    .home-key__name {
        font: 900 1.45rem/1.1 var(--ms-font-head);
        color: var(--ms-text);
        margin: 4px 0 8px;
    }
    .ms-door-band {
        background: var(--ms-yellow);
    }
    .ms-door-name {
        font-size: clamp(2.5rem, 7vw, 5.25rem);
    }
</style>
