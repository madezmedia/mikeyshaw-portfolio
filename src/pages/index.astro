---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import BlogFeed from '../components/BlogFeed.astro';
import mikeyShaw from '../images/mikey-shaw.png';

const CALL = 'https://cal.com/mad-ez-media/ai-automation-discovery';

const running = [
    { name: 'LogMem', line: 'Open-source shared memory for teams of AI agents.', href: 'https://github.com/logmem/logmem', cta: 'View on GitHub' },
    { name: 'Mad EZ Media', line: 'The 24/7 AI receptionist for plumbers, HVAC and electricians.', href: 'https://madezmedia.com', cta: 'Visit Mad EZ' },
    { name: 'Folana', line: 'A creator media pipeline that runs on its own, every day.', href: 'https://github.com/madezmedia/folanas-journal', cta: 'View on GitHub' },
];

const keys = [
    { key: 'who', name: 'Who', line: 'The facts that stay put. Who the client is, what they bought, how they like to work.' },
    { key: 'now', name: 'Now', line: 'The current state, overwritten as it changes. What is open, what is blocked, what is next.' },
    { key: 'log', name: 'Log', line: 'Every step, in order, never edited. Who did what and when, so anyone can pick it up.' },
];

const steps = [
    { n: '01', name: 'Free kit', line: 'Set up agent memory yourself this weekend.', href: '/starter-kit', cta: 'Get the kit' },
    { n: '02', name: 'First Shift', line: 'One agent doing one real job, live in a week.', href: CALL, cta: 'Book a call' },
    { n: '03', name: 'Fleet deploy', line: 'A team of agents with shared memory, on your own stack.', href: CALL, cta: 'Book a call' },
    { n: '04', name: 'Ongoing care', line: 'I run it, watch it and improve it every month.', href: CALL, cta: 'Book a call' },
];
---

<Layout title="Mikey Shaw | AI agents that remember your business">
    <Navbar />

    <main class="w-full">
        <!-- 1. Hero -->
        <section class="home-hero max-w-[1440px] mx-auto px-6 md:px-[60px] pt-36 pb-20 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" id="hero">
            <div class="lg:col-span-7 reveal-item opacity-0">
                <div class="home-eyebrow"><span class="num">N° 01</span>Mikey Shaw</div>
                <h1 class="font-display-xl text-[clamp(2.5rem,5.5vw,4.75rem)] leading-[1.05] font-black tracking-tight text-[var(--ms-text)]">
                    Your AI agents shouldn't start <br class="hidden md:block"/><em class="em-gradient font-black">from zero.</em>
                </h1>
                <p class="font-body-md text-lg text-[var(--ms-text)]/85 max-w-xl mt-8 leading-relaxed">
                    I build AI agents that remember your business. They keep shared memory in LogMem, hand work off cleanly and log every step. You stop being the memory, the messenger and the auditor.
                </p>
                <div class="flex flex-wrap gap-4 items-center mt-10">
                    <a class="ms-btn" href="/starter-kit">Get the free kit →</a>
                    <a class="home-btn-ghost" href="#work-with-me">Work with me</a>
                </div>
            </div>
            <div class="lg:col-span-5 reveal-item opacity-0 flex justify-center">
                <Image
                    src={mikeyShaw}
                    alt="Mikey Shaw"
                    class="w-full max-w-md aspect-[4/5] object-cover grayscale contrast-115 brightness-95 hover:grayscale-0 transition-all duration-700 rounded-2xl border border-[var(--ms-border)]"
                    width={800}
                    height={1000}
                    format="avif"
                    quality="high"
                    loading="eager"
                />
            </div>
        </section>

        <!-- 2. Running now -->
        <section class="border-y border-[var(--ms-border)] bg-[var(--ms-surface)]" aria-labelledby="running-title">
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-10">
                <h2 id="running-title" class="home-label mb-6">Running now</h2>
                <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none p-0 m-0">
                    {running.map((r) => (
                        <li class="flex flex-col gap-1">
                            <span class="font-headline font-extrabold text-[var(--ms-text)]">{r.name}</span>
                            <span class="font-sans text-sm text-[var(--ms-muted)] leading-relaxed">{r.line}</span>
                            <a class="home-link mt-1" href={r.href} target="_blank" rel="noopener noreferrer">{r.cta} →</a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- 3. The idea -->
        <section class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-24" id="idea">
            <div class="max-w-3xl reveal-item opacity-0">
                <div class="home-eyebrow"><span class="num">N° 02</span>The idea</div>
                <h2 class="font-display-xl text-[clamp(2rem,4vw,3.25rem)] font-black tracking-tight leading-[1.1] text-[var(--ms-text)]">
                    Most AI forgets everything when the chat ends.
                </h2>
                <p class="font-body-md text-lg text-[var(--ms-text)]/80 mt-6 leading-relaxed">
                    So you explain your business again, every session, to every tool. The fix is simple. Give every agent the same three keys.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 reveal-item opacity-0">
                {keys.map((k) => (
                    <div class={`home-key home-key--${k.key}`}>
                        <span class="home-key__label">Key</span>
                        <h3 class="home-key__name">{k.name}</h3>
                        <p class="font-sans text-sm text-[var(--ms-muted)] leading-relaxed m-0">{k.line}</p>
                    </div>
                ))}
            </div>

            <p class="font-body-md text-lg text-[var(--ms-text)]/80 mt-12 max-w-3xl leading-relaxed reveal-item opacity-0">
                Then your agents hand off work like a real team. Each one reads the same memory, picks up where the last one stopped and leaves a record you can check.
            </p>
            <div class="flex flex-wrap gap-6 mt-6 reveal-item opacity-0">
                <a class="home-link" href="/starter-kit">Get the free kit →</a>
                <a class="home-link" href="https://github.com/logmem/logmem" target="_blank" rel="noopener noreferrer">See LogMem on GitHub →</a>
            </div>
        </section>

        <!-- 4. Ways to work together -->
        <section class="border-t border-[var(--ms-border)] bg-[var(--ms-surface)]" id="work-with-me">
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-24 reveal-item opacity-0">
                <div class="home-eyebrow"><span class="num">N° 03</span>Work with me</div>
                <h2 class="font-display-xl text-[clamp(2rem,4vw,3.25rem)] font-black tracking-tight leading-[1.1] text-[var(--ms-text)] max-w-3xl">
                    Start small. Grow it when it works.
                </h2>
                <ol class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mt-12 list-none p-0">
                    {steps.map((s) => (
                        <li class="home-step">
                            <span class="home-step__n">{s.n}</span>
                            <h3 class="home-step__name">{s.name}</h3>
                            <p class="font-sans text-sm text-[var(--ms-muted)] leading-relaxed m-0 flex-1">{s.line}</p>
                            <a class="home-link mt-6" href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{s.cta} →</a>
                        </li>
                    ))}
                </ol>
                <p class="font-sans text-sm text-[var(--ms-muted)] mt-8">
                    Want the details first? <a class="home-link" href="/fleet">See how a fleet deploy works →</a>
                </p>
            </div>
        </section>

        <!-- 5. Writing -->
        <section class="px-6 md:px-[60px] py-24 border-t border-[var(--ms-border)]" id="intel">
            <div class="max-w-[1440px] mx-auto reveal-item opacity-0">
                <BlogFeed />
            </div>
        </section>

        <!-- 6. Contact -->
        <section class="px-6 md:px-[60px] py-24 bg-[var(--ms-surface)] border-t border-[var(--ms-border)]">
            <div class="max-w-[1440px] mx-auto reveal-item opacity-0">
                <ContactSection />
            </div>
        </section>
    </main>

    <Footer
        copyright="© 2026 Mikey Shaw. All rights reserved."
        links={[
            { label: 'Mad EZ Media', href: 'https://madezmedia.com' },
            { label: 'LogMem', href: 'https://github.com/logmem/logmem' },
            { label: 'Resume', href: '/resume' },
        ]}
    />
</Layout>

<style>
    .home-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        font: 700 0.6875rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ms-accent-text);
    }
    .home-eyebrow .num { color: var(--ms-muted); }
    /* Solid accent, not a gradient: bright ember on white fails contrast. */
    .em-gradient {
        font-style: italic;
        color: var(--ms-accent-text);
    }
    .home-label {
        font: 700 0.6875rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ms-muted);
    }
    .home-link {
        color: var(--ms-text);
        font-weight: 700;
        font-size: 0.875rem;
        text-decoration: underline;
        text-decoration-color: var(--ms-who);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }
    .home-link:hover { color: var(--ms-accent-text); }
    .home-link:focus-visible, .home-btn-ghost:focus-visible {
        outline: 2px solid var(--ms-focus);
        outline-offset: 3px;
        border-radius: 4px;
    }
    .home-btn-ghost {
        display: inline-flex;
        align-items: center;
        min-height: var(--ms-tap);
        padding: 0 22px;
        border-radius: var(--ms-r-button);
        border: 2px solid var(--ms-text);
        color: var(--ms-text);
        font: 700 0.8125rem/1 var(--ms-font-body);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s var(--ms-ease);
    }
    .home-btn-ghost:hover { background: var(--ms-surface); }

    .home-key {
        background: var(--ms-ground);
        border: 1px solid var(--ms-border);
        border-top: 4px solid var(--key);
        border-radius: var(--ms-r-card);
        padding: 24px;
    }
    .home-key--who { --key: var(--ms-who); --key-text: var(--ms-who-text); }
    .home-key--now { --key: var(--ms-now); --key-text: var(--ms-now-text); }
    .home-key--log { --key: var(--ms-log); --key-text: var(--ms-log-text); }
    .home-key__label {
        font: 700 0.625rem/1.4 var(--ms-font-mono);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--key-text);
    }
    .home-key__name {
        font: 900 1.75rem/1.1 var(--ms-font-head);
        color: var(--ms-text);
        margin: 4px 0 10px;
    }

    .home-step {
        display: flex;
        flex-direction: column;
        background: var(--ms-ground);
        border: 1px solid var(--ms-border);
        border-radius: var(--ms-r-card);
        padding: 24px;
    }
    .home-step__n {
        font: 700 0.75rem/1 var(--ms-font-mono);
        letter-spacing: 0.2em;
        color: var(--ms-accent-text);
    }
    .home-step__name {
        font: 800 1.25rem/1.2 var(--ms-font-head);
        color: var(--ms-text);
        margin: 10px 0 8px;
    }
</style>
