---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

// Resume data — Mad EZ Media / Michael Shaw, current version (2026)
const competencies = [
    {
        title: 'AI & Automation',
        desc: 'Multi-agent orchestration, voice AI systems, automated reporting, predictive workflows'
    },
    {
        title: 'Systems Development',
        desc: 'Full-stack (Next.js, React, TypeScript, Node.js), database design (PostgreSQL/Supabase)'
    },
    {
        title: 'Operations & Logistics',
        desc: 'Multi-channel dispatch, real-time coordination, scheduling optimization, fleet management'
    },
    {
        title: 'Business Development',
        desc: 'Client relationship management, CRM design, pipeline tracking, proposal development'
    },
    {
        title: 'Communication',
        desc: 'Multi-channel coordination (phone, email, Slack, Telegram, SMS), 20+ concurrent accounts'
    },
    {
        title: 'Problem Solving',
        desc: 'Production debugging under pressure, rapid triage, root cause analysis'
    }
];

const experience = [
    {
        role: 'Founder & CEO',
        company: 'Mad EZ Media Partners',
        location: 'Charlotte, NC',
        dates: '2020 — Present',
        bullets: [
            'Built and managed a multi-service digital agency serving service businesses across the Southeast',
            'Designed automated content systems producing 10x output in half the time; built custom CRM/pipeline systems (PostgreSQL, Supabase, React)',
            'Coordinated real-time operations across 8+ AI agents and 20+ concurrent client accounts; developed automated performance dashboards'
        ]
    },
    {
        role: 'Founder',
        company: 'SonicBrand AI',
        location: 'Charlotte, NC',
        dates: '2024 — 2025',
        bullets: [
            'Built an audio branding SaaS platform with 490+ TypeScript files, production-grade architecture',
            'Implemented Zustand state management, auth/quota API middleware, SSE streaming, multi-agent voice with ElevenLabs'
        ]
    },
    {
        role: 'Founder',
        company: 'EZ Influencer 360',
        location: 'Charlotte, NC',
        dates: '2024 — 2025',
        bullets: [
            'Architected an AI music influencer platform: character creation, music generation, voice, and video',
            'Full-stack build across Next.js, React Query, Zustand, Tailwind CSS 4, Supabase, OpenAI, RunPod, Mux — 6 dev phases shipped'
        ]
    },
    {
        role: 'General Manager',
        company: 'Crafty Crab Boardwalk INC',
        location: 'Charlotte, NC',
        dates: 'Apr 2018 — Apr 2019',
        bullets: [
            'Managed full restaurant operations: staffing, scheduling, inventory, and P&L accountability',
            'Oversaw daily high-volume service across kitchen, front-of-house, and delivery; recruited and managed 15–25 staff'
        ]
    },
    {
        role: 'Sales Professional',
        company: 'The Goins Group, LLC',
        location: 'Charlotte, NC / Lake Wylie, SC',
        dates: '2019 — 2020',
        bullets: [
            'Sales and business development for a $62M+ real estate investment education and services company',
            'Generated and qualified leads, managed pipeline, and closed deals across multiple channels'
        ]
    },
    {
        role: 'Founder / Digital Strategy Consultant',
        company: 'Hashtix Digital Strategy Consulting',
        location: 'Charlotte, NC',
        dates: '2017 — 2020',
        bullets: [
            'Provided digital marketing and social strategy consulting to local businesses',
            'Built lead generation funnels and automated marketing systems'
        ]
    },
    {
        role: 'Technology Consultant',
        company: 'Independent / Various Clients',
        location: 'Washington, DC & Charlotte, NC',
        dates: '2020 — 2024',
        bullets: [
            'Collaborated with DC government on technology and data management projects',
            'Provided marketing analytics and automation consulting for 20+ clients; built custom web apps, e-commerce, and mobile apps'
        ]
    }
];
---

<Layout title="Michael Shaw | Resume — Operations & Systems Architect">
    <Navbar />

    <main class="pt-32 pb-24 bg-[#faf9f5]">
        <section class="px-6 md:px-[60px] max-w-4xl mx-auto">
            <div class="mb-10">
                <a href="/" class="back-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back to Portfolio
                </a>
            </div>

            <!-- Header -->
            <div class="resume-header">
                <div class="header-left">
                    <h1 class="resume-name">Michael Shaw</h1>
                    <span class="resume-eyebrow">Operations &amp; Systems Architect</span>
                </div>
                <div class="header-right">
                    <span>(202) 300-1442 · michael@madezmedia.com</span>
                    <span>Charlotte, NC Area (Harrisburg) · mikeyshaw.work</span>
                    <span>linkedin.com/in/michael-shaw-clt</span>
                </div>
            </div>

            <!-- Summary -->
            <p class="resume-summary">
                Versatile operations leader and technologist with 20+ years spanning restaurant management, real estate sales, business development, and technology entrepreneurship. Proven record managing fast-paced operations, coordinating teams under pressure, and building systems that scale — from running a full-service restaurant, to founding 6 technology companies, to selling real estate. Looking to bring hustle, systems thinking, and a whatever-it-takes work ethic to a growing operation from Day 1.
            </p>

            <!-- Core Competencies -->
            <div class="resume-section">
                <span class="section-label">Core Competencies</span>
                <div class="competency-grid">
                    {competencies.map((c) => (
                        <div class="competency-item">
                            <strong>{c.title}</strong>
                            <span>{c.desc}</span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Professional Experience -->
            <div class="resume-section">
                <span class="section-label section-label--bordered">Professional Experience</span>
                <div class="experience-list">
                    {experience.map((job) => (
                        <div class="experience-item">
                            <div class="experience-heading">
                                <div class="experience-title-row">
                                    <strong>{job.role}</strong>
                                    <span class="experience-company">— {job.company}, {job.location}</span>
                                </div>
                                <span class="experience-dates">{job.dates}</span>
                            </div>
                            <ul class="experience-bullets">
                                {job.bullets.map((b) => <li>{b}</li>)}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Education -->
            <div class="resume-section">
                <span class="section-label section-label--bordered">Education</span>
                <div class="education-row">
                    <div class="experience-title-row">
                        <strong>Continuing Education — AI &amp; Full-Stack Development</strong>
                        <span class="experience-company">— Self-directed / Online</span>
                    </div>
                    <span class="experience-dates">2020 – Present</span>
                </div>
                <ul class="experience-bullets">
                    <li>Advanced AI integration and multi-agent system architecture</li>
                    <li>Full-stack web development (JavaScript, TypeScript, React, Next.js, Node.js)</li>
                    <li>Database design, cloud infrastructure, and deployment (PostgreSQL, Supabase, Vercel, Docker, CI/CD)</li>
                </ul>
            </div>

            <!-- Footer: Technical Skills / Key Projects -->
            <div class="resume-footer">
                <div class="footer-col">
                    <span class="section-label section-label--bordered">Technical Skills</span>
                    <div class="skills-list">
                        <span><strong>Languages:</strong> JavaScript, TypeScript, Python, SQL, HTML/CSS</span>
                        <span><strong>Frameworks:</strong> Next.js, React, Node.js, Astro, Tailwind CSS</span>
                        <span><strong>Databases:</strong> PostgreSQL, Supabase, Prisma ORM, IndexedDB</span>
                        <span><strong>AI/ML:</strong> OpenAI GPT-4, ElevenLabs, RunPod, Mux, FAL, custom agents</span>
                        <span><strong>Cloud &amp; DevOps:</strong> Vercel, GitHub Actions, Docker, Supabase Cloud</span>
                        <span><strong>Tools:</strong> Git/GitHub, QuickBooks, Slack, CRMs, Figma, Cal.com</span>
                    </div>
                </div>
                <div class="footer-col">
                    <span class="section-label section-label--bordered">Key Projects</span>
                    <div class="skills-list">
                        <span><strong>Mad EZ AI Fleet</strong> — Private multi-agent deployment system for local service businesses (live client engagements, 2026)</span>
                        <span><strong>SonicBrand AI</strong> — Audio branding SaaS, 490+ TypeScript files in production</span>
                        <span><strong>OwnerScout</strong> — Restaurant tech analysis tool, multi-tier caching (80–95% API cost cut)</span>
                        <span class="footer-meta">mikeyshaw.work · github.com/madezmedia</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="px-6 md:px-[60px] py-12 border-t border-primary/10 flex justify-between items-center bg-surface-container text-primary">
        <div class="font-headline-lg text-4xl font-black">MS<span class="text-primary/40">.</span></div>
        <div class="font-label-mono text-[9px] opacity-40 uppercase tracking-[0.3em]">
            © 2026 MAD EZ MEDIA. ALL RIGHTS RESERVED.
        </div>
    </footer>
</Layout>

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: "Outfit", sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        color: #2d4a3e;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .back-link:hover {
        opacity: 0.7;
    }

    .resume-header {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 2px solid #2d4a3e;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    @media (min-width: 768px) {
        .resume-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-left {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .resume-name {
        margin: 0;
        font-family: "Playfair Display", serif;
        font-weight: 900;
        font-size: clamp(2rem, 4vw, 2.75rem);
        letter-spacing: 0.005em;
        color: #2d4a3e;
        line-height: 1;
    }

    .resume-eyebrow {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #E5007D;
    }

    .header-right {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        color: rgba(45, 74, 62, 0.7);
        text-align: left;
    }

    @media (min-width: 768px) {
        .header-right {
            text-align: right;
        }
    }

    .resume-summary {
        margin: 0 0 2rem;
        font-family: "Outfit", sans-serif;
        font-size: 0.95rem;
        line-height: 1.65;
        color: rgba(45, 74, 62, 0.85);
        max-width: 60ch;
    }

    .resume-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2.25rem;
    }

    .section-label {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(45, 74, 62, 0.55);
    }

    .section-label--bordered {
        border-bottom: 1px solid rgba(45, 74, 62, 0.15);
        padding-bottom: 0.6rem;
    }

    .competency-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem 2rem;
    }

    @media (min-width: 640px) {
        .competency-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .competency-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .competency-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .competency-item strong {
        font-family: "Outfit", sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #2d4a3e;
    }

    .competency-item span {
        font-family: "Outfit", sans-serif;
        font-size: 0.82rem;
        line-height: 1.5;
        color: rgba(45, 74, 62, 0.72);
    }

    .experience-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .experience-item {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .experience-heading,
    .education-row {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        justify-content: space-between;
        align-items: flex-start;
    }

    @media (min-width: 640px) {
        .experience-heading,
        .education-row {
            flex-direction: row;
            align-items: baseline;
        }
    }

    .experience-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.4rem;
    }

    .experience-title-row strong {
        font-family: "Playfair Display", serif;
        font-size: 1.1rem;
        font-weight: 800;
        color: #2d4a3e;
    }

    .experience-company {
        font-family: "Outfit", sans-serif;
        font-size: 0.88rem;
        color: rgba(45, 74, 62, 0.6);
    }

    .experience-dates {
        font-family: "JetBrains Mono", monospace;
        font-size: 10.5px;
        color: rgba(45, 74, 62, 0.55);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .experience-bullets {
        margin: 0;
        padding-left: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .experience-bullets li {
        font-family: "Outfit", sans-serif;
        font-size: 0.88rem;
        line-height: 1.55;
        color: rgba(45, 74, 62, 0.8);
    }

    .education-row {
        margin-bottom: 0.5rem;
    }

    .resume-footer {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-top: 1rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(45, 74, 62, 0.15);
    }

    @media (min-width: 768px) {
        .resume-footer {
            grid-template-columns: 1.4fr 1fr;
        }
    }

    .footer-col {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .skills-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-family: "Outfit", sans-serif;
        font-size: 0.82rem;
        line-height: 1.55;
        color: rgba(45, 74, 62, 0.8);
    }

    .skills-list strong {
        color: #2d4a3e;
    }

    .footer-meta {
        font-family: "JetBrains Mono", monospace;
        font-size: 10.5px;
        color: rgba(45, 74, 62, 0.6);
        margin-top: 0.25rem;
    }
</style>
