---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout title="AI Tools Assessment & Operational Audit | Mad EZ Media — Mikey Shaw">
  <!-- Navigation Bar -->
  <Navbar />

  <main class="w-full bg-[#faf9f5] overflow-x-hidden text-[#2d4a3e]">
    <!-- Hero Section -->
    <section class="pt-32 pb-20 md:pt-40 md:pb-28 px-6 max-w-7xl mx-auto relative overflow-hidden">
      <!-- Subtle background glow -->
      <div class="absolute top-10 right-10 w-96 h-96 bg-[#00B9F1]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-10 left-10 w-96 h-96 bg-[#E5007D]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-4xl relative z-10">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#2d4a3e]/5 border border-[#2d4a3e]/15 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#E5007D] animate-pulse"></span>
          <span class="font-label-mono text-xs uppercase tracking-[0.25em] font-semibold text-[#2d4a3e]">
            N° 01 • OPERATIONAL LEAK AUDIT
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-display-xl text-[clamp(2.4rem,5.5vw,4.5rem)] leading-[1.08] font-black tracking-tight text-[#2d4a3e]">
          Stop Buying AI That Forgets Your Business <em class="italic text-[#E5007D] font-black">Every Time You Close The Tab.</em>
        </h1>

        <!-- Subheadline -->
        <p class="font-body-lg text-lg md:text-xl text-[#2d4a3e]/85 max-w-3xl mt-8 leading-relaxed font-normal">
          Off-the-shelf chatbots lose context the second you refresh. We audit your 7 core operational leaks, deploy persistent ACMI memory architectures (Profile / Signals / Timeline), and hand you back 5–15 hours every single week.
        </p>

        <!-- CTA Action Bar -->
        <div class="flex flex-wrap items-center gap-4 mt-10">
          <a
            href="https://cal.com/mad-ez-media/ai-automation-discovery"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#2d4a3e] text-white px-8 py-4 font-bold text-xs uppercase tracking-widest hover:bg-[#3a5c4e] hover:-translate-y-[1px] active:translate-y-0 transition-all rounded-full no-underline inline-flex items-center gap-3 shadow-md"
          >
            Book Free 15-Min Consult
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

          <a
            href="#pricing"
            class="bg-white text-[#2d4a3e] border border-[#2d4a3e]/20 px-8 py-4 font-bold text-xs uppercase tracking-widest hover:border-[#E5007D] hover:text-[#E5007D] transition-all rounded-full no-underline shadow-sm"
          >
            Claim $499 Assessment →
          </a>
        </div>

        <!-- Key Metrics Strip -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16 pt-10 border-t border-[#2d4a3e]/15">
          <div class="flex items-start gap-4">
            <div class="p-3 bg-[#E5007D]/10 rounded-xl text-[#E5007D]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <span class="font-label-mono text-xs uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block">Annual Labor Savings</span>
              <span class="font-display text-2xl font-bold text-[#2d4a3e]">$10,400 / emp</span>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 bg-[#00B9F1]/10 rounded-xl text-[#00B9F1]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <span class="font-label-mono text-xs uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block">Time Recovered</span>
              <span class="font-display text-2xl font-bold text-[#2d4a3e]">5+ hrs / wk</span>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 bg-[#FCDC00]/20 rounded-xl text-[#2d4a3e]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <div>
              <span class="font-label-mono text-xs uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block">White-Glove Guarantee</span>
              <span class="font-display text-2xl font-bold text-[#2d4a3e]">100% Risk Free</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The 7 Leaks Grid Section -->
    <section class="py-24 px-6 max-w-7xl mx-auto" id="leaks">
      <div class="max-w-3xl mb-16">
        <span class="font-label-mono text-xs uppercase tracking-[0.25em] text-[#E5007D] font-bold block mb-3">
          N° 02 • THE 7 OPERATIONAL LEAKS
        </span>
        <h2 class="font-display-xl text-3xl md:text-5xl font-black text-[#2d4a3e] tracking-tight leading-tight">
          Where Your Business Is Bleeding Time & Revenue Every Day.
        </h2>
        <p class="font-body-lg text-lg text-[#2d4a3e]/80 mt-4 leading-relaxed">
          Most owners try to solve operational chaos with another $20/mo subscription. But software without persistent memory just creates more tab-switching. Here are the 7 leaks we fix:
        </p>
      </div>

      <!-- 7 Leaks Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Leak 1: Missed Calls -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-[#E5007D]/5 rounded-bl-full pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#E5007D]/10 text-[#E5007D] rounded-full font-bold">
                LEAK 01 • INBOUND
              </span>
              <svg class="w-6 h-6 text-[#E5007D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-[#2d4a3e] mb-3">
              Missed Calls
            </h3>
            <p class="font-body-lg text-base font-semibold text-[#E5007D] mb-4 italic">
              "You miss the call, they call the next guy."
            </p>
            <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed mb-6">
              62% of inbound service leads choose the first company that answers or replies. Unanswered calls go straight to voice mail and then to your competitor.
            </p>
          </div>
          <div class="pt-4 border-t border-[#2d4a3e]/10">
            <span class="font-label-mono text-[11px] uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-1">ACMI Infrastructure Fix:</span>
            <span class="font-sans text-xs text-[#2d4a3e] font-bold block">Instant AI call capture & automated SMS handshake within 10s.</span>
          </div>
        </div>

        <!-- Leak 2: Cold Leads -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-[#00B9F1]/5 rounded-bl-full pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#00B9F1]/10 text-[#00B9F1] rounded-full font-bold">
                LEAK 02 • TRIAGE
              </span>
              <svg class="w-6 h-6 text-[#00B9F1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-[#2d4a3e] mb-3">
              Cold Leads
            </h3>
            <p class="font-body-lg text-base font-semibold text-[#00B9F1] mb-4 italic">
              "Leads sit in inbox overnight while competitors reply in 60s."
            </p>
            <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed mb-6">
              Web forms and email inquiries that wait 12+ hours for a manual response suffer an 80% drop in booking probability compared to sub-5-minute replies.
            </p>
          </div>
          <div class="pt-4 border-t border-[#2d4a3e]/10">
            <span class="font-label-mono text-[11px] uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-1">ACMI Infrastructure Fix:</span>
            <span class="font-sans text-xs text-[#2d4a3e] font-bold block">24/7 autonomous email triage & lead qualification agent.</span>
          </div>
        </div>

        <!-- Leak 3: Late Quotes -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-[#FCDC00]/10 rounded-bl-full pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#FCDC00]/30 text-[#2d4a3e] rounded-full font-bold">
                LEAK 03 • PIPELINE
              </span>
              <svg class="w-6 h-6 text-[#2d4a3e]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-[#2d4a3e] mb-3">
              Late Quotes
            </h3>
            <p class="font-body-lg text-base font-semibold text-[#2d4a3e] mb-4 italic">
              "It's 9pm and you're still doing manual quotes and invoices."
            </p>
            <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed mb-6">
              Spending your evenings calculating line items in spreadsheets kills your energy and delays closing deals. Slow estimates lead to lost jobs.
            </p>
          </div>
          <div class="pt-4 border-t border-[#2d4a3e]/10">
            <span class="font-label-mono text-[11px] uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-1">ACMI Infrastructure Fix:</span>
            <span class="font-sans text-xs text-[#2d4a3e] font-bold block">Instant estimate engine & automated client approval dispatch.</span>
          </div>
        </div>

        <!-- Leak 4: Repeat Questions -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-[#E5007D]/5 rounded-bl-full pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#E5007D]/10 text-[#E5007D] rounded-full font-bold">
                LEAK 04 • SUPPORT
              </span>
              <svg class="w-6 h-6 text-[#E5007D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-[#2d4a3e] mb-3">
              Repeat Questions
            </h3>
            <p class="font-body-lg text-base font-semibold text-[#E5007D] mb-4 italic">
              "Answering the same 5 questions 20 times a day."
            </p>
            <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed mb-6">
              Pricing, availability, service areas, and process questions consume hours of administrative capacity that should be spent executing high-margin work.
            </p>
          </div>
          <div class="pt-4 border-t border-[#2d4a3e]/10">
            <span class="font-label-mono text-[11px] uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-1">ACMI Infrastructure Fix:</span>
            <span class="font-sans text-xs text-[#2d4a3e] font-bold block">Context-trained auto-responder across SMS, email, and web.</span>
          </div>
        </div>

        <!-- Leak 5: Scheduling Ping-Pong -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-[#00B9F1]/5 rounded-bl-full pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#00B9F1]/10 text-[#00B9F1] rounded-full font-bold">
                LEAK 05 • CALENDAR
              </span>
              <svg class="w-6 h-6 text-[#00B9F1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-[#2d4a3e] mb-3">
              Scheduling Ping-Pong
            </h3>
            <p class="font-body-lg text-base font-semibold text-[#00B9F1] mb-4 italic">
              "6 back-and-forth emails just to pick a 30-min slot."
            </p>
            <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed mb-6">
              Calendar friction kills deal momentum. Every unnecessary email exchange gives prospects a chance to lose interest or find an alternative.
            </p>
          </div>
          <div class="pt-4 border-t border-[#2d4a3e]/10">
            <span class="font-label-mono text-[11px] uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-1">ACMI Infrastructure Fix:</span>
            <span class="font-sans text-xs text-[#2d4a3e] font-bold block">Autonomous calendar handshake & SMS confirmation engine.</span>
          </div>
        </div>

        <!-- Leak 6: No Reviews -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-[#FCDC00]/10 rounded-bl-full pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#FCDC00]/30 text-[#2d4a3e] rounded-full font-bold">
                LEAK 06 • REPUTATION
              </span>
              <svg class="w-6 h-6 text-[#2d4a3e]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-[#2d4a3e] mb-3">
              No Reviews
            </h3>
            <p class="font-body-lg text-base font-semibold text-[#2d4a3e] mb-4 italic">
              "Happy clients leave without leaving Google reviews."
            </p>
            <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed mb-6">
              Clients are thrilled when you finish the job, but unless you ask at the exact right moment via automated follow-up, 90% forget to leave a review.
            </p>
          </div>
          <div class="pt-4 border-t border-[#2d4a3e]/10">
            <span class="font-label-mono text-[11px] uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-1">ACMI Infrastructure Fix:</span>
            <span class="font-sans text-xs text-[#2d4a3e] font-bold block">Automated post-service review request & sentiment filter dispatch.</span>
          </div>
        </div>

        <!-- Leak 7: Night Paperwork (Featured Full-width or Accent Card) -->
        <div class="bg-white rounded-2xl p-8 border border-[#2d4a3e]/10 shadow-sm stagger-card flex flex-col justify-between relative overflow-hidden md:col-span-2 lg:col-span-3 border-l-4 border-l-[#E5007D]">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="max-w-2xl">
              <div class="flex items-center gap-3 mb-3">
                <span class="font-label-mono text-[10px] uppercase tracking-widest px-3 py-1 bg-[#E5007D] text-white rounded-full font-bold">
                  LEAK 07 • OPERATIONS
                </span>
                <span class="font-label-mono text-xs text-[#E5007D] font-bold uppercase tracking-wider">The Ultimate Founder Bottleneck</span>
              </div>
              <h3 class="font-display text-2xl md:text-3xl font-bold text-[#2d4a3e] mb-2">
                Night Paperwork
              </h3>
              <p class="font-body-lg text-lg font-semibold text-[#E5007D] mb-3 italic">
                "Drowning in spreadsheets after the workday ends."
              </p>
              <p class="font-sans text-sm text-[#2d4a3e]/80 leading-relaxed">
                Manually copying data between your CRM, email, calendar, and accounting tools forces you into late-night admin work. Your business shouldn't depend on manual copy-pasting.
              </p>
            </div>
            <div class="bg-[#faf9f5] p-6 rounded-xl border border-[#2d4a3e]/15 min-w-[280px]">
              <span class="font-label-mono text-xs uppercase tracking-wider text-[#2d4a3e]/60 font-semibold block mb-2">ACMI Infrastructure Fix</span>
              <span class="font-sans text-sm text-[#2d4a3e] font-bold block leading-snug">
                Autonomous background sync across CRM, QuickBooks, and fleet ops — zero manual data entry.
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive ROI Labor Calculator Section -->
    <section class="py-24 px-6 bg-[#2d4a3e] text-white relative overflow-hidden" id="calculator">
      <!-- Background pattern -->
      <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle at 10% 20%, #e5007d 0%, transparent 40%), radial-gradient(circle at 90% 80%, #00b9f1 0%, transparent 40%);"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="max-w-3xl mb-16">
          <span class="font-label-mono text-xs uppercase tracking-[0.25em] text-[#00B9F1] font-bold block mb-3">
            N° 03 • ROI LABOR CALCULATOR
          </span>
          <h2 class="font-display-xl text-3xl md:text-5xl font-black tracking-tight leading-tight">
            Calculate Your Annual Labor Leakage.
          </h2>
          <p class="font-sans text-lg text-white/80 mt-4 leading-relaxed">
            Our standard operational model assumes a conservative baseline of <strong class="text-[#FCDC00]">$10,400 per employee in annual labor savings</strong> (5 wasted hours/week at $40/hr). Adjust the sliders below to see what your business is currently losing.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <!-- Interactive Sliders (7 cols) -->
          <div class="lg:col-span-7 bg-white/5 backdrop-blur-md p-8 md:p-10 rounded-2xl border border-white/10 space-y-8">
            <!-- Slider 1: Team Size -->
            <div>
              <div class="flex justify-between items-center mb-3">
                <label for="emp-slider" class="font-label-mono text-xs uppercase tracking-wider text-white/90 font-semibold">
                  1. Team Size / Employees
                </label>
                <span class="font-display text-2xl font-bold text-[#00B9F1]" id="emp-val">5 employees</span>
              </div>
              <input
                type="range"
                id="emp-slider"
                min="1"
                max="50"
                value="5"
                class="w-full h-3 bg-white/20 rounded-lg appearance-none cursor-pointer accent-[#00B9F1]"
              />
              <div class="flex justify-between text-[10px] font-label-mono text-white/50 mt-1">
                <span>1 Emp</span>
                <span>25 Emps</span>
                <span>50 Emps</span>
              </div>
            </div>

            <!-- Slider 2: Average Hourly Rate -->
            <div>
              <div class="flex justify-between items-center mb-3">
                <label for="rate-slider" class="font-label-mono text-xs uppercase tracking-wider text-white/90 font-semibold">
                  2. Average Hourly Labor Rate
                </label>
                <span class="font-display text-2xl font-bold text-[#FCDC00]" id="rate-val">$40 / hr</span>
              </div>
              <input
                type="range"
                id="rate-slider"
                min="20"
                max="150"
                step="5"
                value="40"
                class="w-full h-3 bg-white/20 rounded-lg appearance-none cursor-pointer accent-[#FCDC00]"
              />
              <div class="flex justify-between text-[10px] font-label-mono text-white/50 mt-1">
                <span>$20/hr</span>
                <span>$85/hr</span>
                <span>$150/hr</span>
              </div>
            </div>

            <!-- Slider 3: Wasted Hours per Week -->
            <div>
              <div class="flex justify-between items-center mb-3">
