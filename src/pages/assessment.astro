<!-- Client-side Interactive ROI Calculator Script -->
<script>
  function initCalculator() {
    const empSlider = document.getElementById('emp-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('rate-slider') as HTMLInputElement | null;
    const hoursSlider = document.getElementById('hours-slider') as HTMLInputElement | null;

    const empVal = document.getElementById('emp-val');
    const rateVal = document.getElementById('rate-val');
    const hoursVal = document.getElementById('hours-val');

    const totalLossDisplay = document.getElementById('total-loss-display');
    const perEmpDisplay = document.getElementById('per-emp-display');
    const hoursRecDisplay = document.getElementById('hours-rec-display');
    const roiDisplay = document.getElementById('roi-display');

    if (!empSlider || !rateSlider || !hoursSlider) return;

    function calculate() {
      const emps = parseInt(empSlider.value, 10);
      const rate = parseInt(rateSlider.value, 10);
      const hours = parseInt(hoursSlider.value, 10);

      // Update slider labels
      if (empVal) empVal.textContent = `${emps} ${emps === 1 ? 'employee' : 'employees'}`;
      if (rateVal) rateVal.textContent = `$${rate} / hr`;
      if (hoursVal) hoursVal.textContent = `${hours} hrs / wk`;

      // Core Math: 52 working weeks per year
      const perEmpAnnualLoss = hours * rate * 52;
      const totalAnnualLoss = emps * perEmpAnnualLoss;
      const totalHoursRecovered = emps * hours * 52;

      const auditCost = 499;
      const roiPercent = Math.round(((totalAnnualLoss - auditCost) / auditCost) * 100);

      // Format currency
      const formattedTotal = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(totalAnnualLoss);
      const formattedPerEmp = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(perEmpAnnualLoss);
      const formattedHours = new Intl.NumberFormat('en-US').format(totalHoursRecovered);

      if (totalLossDisplay) totalLossDisplay.textContent = `${formattedTotal} / yr`;
      if (perEmpDisplay) perEmpDisplay.textContent = `${formattedPerEmp} / yr`;
      if (hoursRecDisplay) hoursRecDisplay.textContent = `${formattedHours} hrs`;
      if (roiDisplay) roiDisplay.textContent = `${roiPercent.toLocaleString()}%`;
    }

    empSlider.addEventListener('input', calculate);
    rateSlider.addEventListener('input', calculate);
    hoursSlider.addEventListener('input', calculate);

    // Initial run
    calculate();
  }

  // Bind on load and Astro page load transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalculator);
  } else {
    initCalculator();
  }
  document.addEventListener('astro:page-load', initCalculator);
</script>
