---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout title="Do Greater x Madez Media | Partnership Proposal">
    <Navbar />

    <main class="proposal-page">
        <!-- HERO -->
        <section class="proposal-hero">
            <div class="hero-badge">PARTNERSHIP PROPOSAL</div>
            <h1 class="hero-title">
                Do Greater <span class="gold">x</span> Madez Media
            </h1>
            <p class="hero-subtitle">Prepared for <strong>William & the Do Greater team</strong> — July 2026</p>
            <div class="hero-divider"></div>
            <p class="hero-tagline">
                I love what you've built at Sparkhouse.<br>
                I'd love a little more time to help it go further.
            </p>
        </section>

        <!-- THE PROPOSITION -->
        <section class="proposal-section">
            <div class="section-label">WHERE THIS STARTED</div>
            <h2 class="section-title">A visit, a conversation, and a few things I noticed.</h2>
            <p class="section-body">
                I stopped by Sparkhouse Uptown and got to see Code the City, the CRTV Lab, and the
                whole operation in person — and it's the real thing. Afterward we talked briefly
                about where the technology gaps actually are: email capture, the digital marketing
                stack, and how a partner could supply the infrastructure instead of Do Greater having
                to own it outright.
            </p>
            <p class="section-body">
                This is a first pass at turning that conversation into something concrete — not a
                sales pitch, just what I'd actually do if given a bit more time to dig in.
            </p>
            <div class="value-cards">
                <div class="value-card">
                    <div class="value-icon">💰</div>
                    <h3>Free Money, Unclaimed</h3>
                    <p>Google's Ad Grant — up to $120K/year in free search ads. Do Greater already qualifies and hasn't claimed it.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🔍</div>
                    <h3>Findable, Not Yet Found</h3>
                    <p>Search Console isn't set up, the Business Profile is unclaimed — Do Greater is harder to find online than the mission deserves.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">📍</div>
                    <h3>Foot Traffic, No Follow-Up</h3>
                    <p>Sparkhouse Coffee, the showroom, the coworking floor — real traffic every day with no way to stay in touch afterward.</p>
                </div>
            </div>
        </section>

        <!-- WHO I AM -->
        <section class="proposal-section alt-bg">
            <div class="section-label">WHO I AM</div>
            <h2 class="section-title">Mikey Shaw — At a Glance</h2>

            <div class="profile-grid">
                <div class="profile-stats">
                    <div class="stat">
                        <span class="stat-number">20+</span>
                        <span class="stat-label">Years Building Systems</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">6</span>
                        <span class="stat-label">Companies Founded</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">Charlotte</span>
                        <span class="stat-label">Based, Local</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">Not Billed</span>
                        <span class="stat-label">To Start</span>
                    </div>
                </div>

                <div class="profile-details">
                    <div class="detail-item">
                        <span class="detail-label">Company</span>
                        <span class="detail-value">Madez Media — Founder</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Specialization</span>
                        <span class="detail-value">AI systems, marketing infrastructure, digital operations</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Core Skill</span>
                        <span class="detail-value">Turning "we should really fix that" into something that ships</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Location</span>
                        <span class="detail-value">Charlotte, NC</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- THE PLAN -->
        <section class="proposal-section">
            <div class="section-label">A FIRST 90 DAYS</div>
            <h2 class="section-title">How This Could Actually Move</h2>

            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker">1</div>
                    <div class="timeline-content">
                        <h3>Days 1-30 <span class="gold">// The Free Wins</span></h3>
                        <ul>
                            <li>Claim and verify Google for Nonprofits + the Ad Grant application</li>
                            <li>Claim the Google Business Profile, get Search Console reporting live</li>
                            <li>Wire up basic conversion tracking so the Ad Grant stays compliant</li>
                            <li><strong>Goal:</strong> The free money and free visibility are actually turned on</li>
                        </ul>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-marker">2</div>
                    <div class="timeline-content">
                        <h3>Days 31-60 <span class="gold">// The Infrastructure Ask</span></h3>
                        <ul>
                            <li>Turn the partner-infra conversation into a specific, fundable line item — a signup + email-capture stack a partner can supply and Do Greater can run without new headcount</li>
                            <li>A QR/signup flow at Sparkhouse Coffee and the showroom floor, tied into that same system</li>
                            <li><strong>Goal:</strong> A concrete ask ready to bring to a partner conversation</li>
                        </ul>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-marker">3</div>
                    <div class="timeline-content">
                        <h3>Days 61-90 <span class="gold">// Momentum</span></h3>
                        <ul>
                            <li>Get Do Greater actually surfacing for the searches it should own — "youth entrepreneurship programs Charlotte" and similar</li>
                            <li>Start a TikTok presence where the 16-24 crowd already is</li>
                            <li><strong>Goal:</strong> Do Greater is easier to find, and the foot traffic has somewhere to go</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- THE ASK -->
        <section class="proposal-section alt-bg">
            <div class="section-label">THE ASK</div>
            <h2 class="section-title">What I'm Actually Proposing</h2>

            <div class="ask-grid">
                <div class="ask-item">
                    <div class="ask-label">Role</div>
                    <div class="ask-value">Advisor / systems help, informal to start</div>
                </div>
                <div class="ask-item">
                    <div class="ask-label">Type</div>
                    <div class="ask-value">Not billed — genuinely just because I believe in this</div>
                </div>
                <div class="ask-item">
                    <div class="ask-label">First Step</div>
                    <div class="ask-value">More time with you and Amanda to actually dig in, not guess from the outside</div>
                </div>
                <div class="ask-item">
                    <div class="ask-label">If It Grows</div>
                    <div class="ask-value">Happy to formalize into a real engagement later — only if and when it makes sense for Do Greater</div>
                </div>
            </div>
        </section>

        <!-- CLOSING -->
        <section class="proposal-section closing">
            <div class="closing-quote">
                "You already qualify for $120K a year in free advertising.<br>
                That's not a pitch — that's just true. Let's go claim it."<br>
                <span class="closing-author">— Mikey Shaw</span>
            </div>

            <div class="closing-cta">
                <div class="cta-links">
                    <a href="https://do-greater.vercel.app" target="_blank" rel="noopener" class="cta-button primary">View the Do Greater Notes</a>
                    <a href="https://do-greater.vercel.app/coach-mac/" target="_blank" rel="noopener" class="cta-button secondary">Read the Note to Coach Mac</a>
                </div>
                <p class="cta-note">madezmediapartners@gmail.com • Charlotte, NC</p>
            </div>
        </section>
    </main>

    <style>
        .proposal-page {
            max-width: 900px;
            margin: 0 auto;
            padding: 120px 2rem 4rem;
        }

        /* HERO */
        .proposal-hero {
            text-align: center;
            margin-bottom: 4rem;
        }
        .hero-badge {
            display: inline-block;
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid var(--primary-dark, #D4AF37);
            color: var(--primary-dark, #D4AF37);
            padding: 6px 20px;
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            margin-bottom: 2rem;
        }
        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 800;
            color: white;
            line-height: 1.1;
            margin-bottom: 0.5rem;
        }
        .gold { color: var(--primary-dark, #D4AF37); }
        .hero-subtitle {
            color: #999;
            font-size: 1rem;
            margin: 1.5rem 0;
        }
        .hero-subtitle strong {
            color: var(--primary-dark, #D4AF37);
        }
        .hero-divider {
            width: 80px;
            height: 3px;
            background: var(--primary-dark, #D4AF37);
            margin: 2rem auto;
        }
        .hero-tagline {
            font-size: 1.25rem;
            color: #ccc;
            font-style: italic;
            line-height: 1.6;
        }

        /* SECTIONS */
        .proposal-section {
            margin-bottom: 4rem;
            padding: 3rem;
            border-radius: 12px;
        }
        .proposal-section.alt-bg {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        .section-label {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            color: var(--primary-dark, #D4AF37);
            margin-bottom: 1rem;
        }
        .section-title {
            font-size: clamp(1.5rem, 3vw, 2rem);
            font-weight: 700;
            color: white;
            margin-bottom: 1.5rem;
        }
        .section-body {
            color: #bbb;
            font-size: 1.05rem;
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        /* VALUE CARDS */
        .value-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }
        .value-card {
            background: rgba(212, 175, 55, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 10px;
            padding: 2rem 1.5rem;
            text-align: center;
        }
        .value-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        .value-card h3 {
            color: white;
            font-size: 1.1rem;
            margin-bottom: 0.75rem;
        }
        .value-card p {
            color: #999;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        /* PROFILE GRID */
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }
        .profile-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }
        .stat {
            text-align: center;
            padding: 1.5rem;
            background: rgba(212, 175, 55, 0.05);
            border-radius: 10px;
        }
        .stat-number {
            display: block;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--primary-dark, #D4AF37);
        }
        .stat-label {
            display: block;
            font-size: 0.75rem;
            color: #999;
            margin-top: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .profile-details {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .detail-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--primary-dark, #D4AF37);
            font-weight: 600;
        }
        .detail-value {
            color: #ddd;
            font-size: 0.95rem;
        }

        /* TIMELINE */
        .timeline {
            margin-top: 2rem;
        }
        .timeline-item {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .timeline-item:last-child {
            border-bottom: none;
        }
        .timeline-marker {
            flex-shrink: 0;
            width: 48px;
            height: 48px;
            background: var(--primary-dark, #D4AF37);
            color: #121212;
            font-weight: 800;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        .timeline-content h3 {
            color: white;
            font-size: 1.1rem;
            margin-bottom: 0.75rem;
        }
        .timeline-content ul {
            list-style: none;
            padding: 0;
        }
        .timeline-content li {
            color: #bbb;
            font-size: 0.9rem;
            line-height: 1.6;
            padding-left: 1.25rem;
            position: relative;
            margin-bottom: 0.5rem;
        }
        .timeline-content li::before {
            content: '→';
            position: absolute;
            left: 0;
            color: var(--primary-dark, #D4AF37);
        }
        .timeline-content li strong {
            color: var(--primary-dark, #D4AF37);
        }

        /* ASK GRID */
        .ask-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-top: 2rem;
        }
        .ask-item {
            padding: 1.5rem;
            background: rgba(212, 175, 55, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 8px;
        }
        .ask-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--primary-dark, #D4AF37);
            font-weight: 600;
            margin-bottom: 0.4rem;
        }
        .ask-value {
            color: white;
            font-size: 1rem;
            font-weight: 500;
        }

        /* CLOSING */
        .closing {
            text-align: center;
            padding: 4rem 3rem;
        }
        .closing-quote {
            font-size: clamp(1.2rem, 2.5vw, 1.5rem);
            color: white;
            line-height: 1.6;
            font-style: italic;
            margin-bottom: 0.75rem;
        }
        .closing-author {
            display: block;
            color: var(--primary-dark, #D4AF37);
            font-style: normal;
            font-size: 1rem;
            margin-top: 1rem;
        }
        .closing-cta {
            margin-top: 3rem;
        }
        .cta-links {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }
        .cta-button {
            display: inline-block;
            padding: 14px 32px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .cta-button:hover {
            transform: translateY(-2px);
        }
        .cta-button.primary {
            background: var(--primary-dark, #D4AF37);
            color: #121212;
        }
        .cta-button.secondary {
            border: 2px solid var(--primary-dark, #D4AF37);
            color: var(--primary-dark, #D4AF37);
        }
        .cta-note {
            color: #777;
            font-size: 0.85rem;
        }

        /* LIGHT MODE OVERRIDES */
        :root[data-theme='light'] .proposal-page { color: #212529; }
        :root[data-theme='light'] .hero-badge {
            background: rgba(40, 167, 69, 0.1);
            border-color: #28A745;
            color: #28A745;
        }
        :root[data-theme='light'] .hero-title { color: #212529; }
        :root[data-theme='light'] .gold { color: #28A745; }
        :root[data-theme='light'] .hero-subtitle { color: #6C757D; }
        :root[data-theme='light'] .hero-subtitle strong { color: #28A745; }
        :root[data-theme='light'] .hero-divider { background: #28A745; }
        :root[data-theme='light'] .hero-tagline { color: #495057; }
        :root[data-theme='light'] .proposal-section.alt-bg {
            background: rgba(0, 0, 0, 0.02);
            border-color: rgba(0, 0, 0, 0.08);
        }
        :root[data-theme='light'] .section-label { color: #28A745; }
        :root[data-theme='light'] .section-title { color: #212529; }
        :root[data-theme='light'] .section-body { color: #495057; }
        :root[data-theme='light'] .value-card {
            background: rgba(40, 167, 69, 0.05);
            border-color: rgba(40, 167, 69, 0.2);
        }
        :root[data-theme='light'] .value-card h3 { color: #212529; }
        :root[data-theme='light'] .value-card p { color: #6C757D; }
        :root[data-theme='light'] .stat { background: rgba(40, 167, 69, 0.06); }
        :root[data-theme='light'] .stat-number { color: #28A745; }
        :root[data-theme='light'] .stat-label { color: #6C757D; }
        :root[data-theme='light'] .detail-item { border-bottom-color: rgba(0, 0, 0, 0.08); }
        :root[data-theme='light'] .detail-label { color: #28A745; }
        :root[data-theme='light'] .detail-value { color: #212529; }
        :root[data-theme='light'] .timeline-item { border-bottom-color: rgba(0, 0, 0, 0.08); }
        :root[data-theme='light'] .timeline-marker { background: #28A745; color: white; }
        :root[data-theme='light'] .timeline-content h3 { color: #212529; }
        :root[data-theme='light'] .timeline-content li { color: #495057; }
        :root[data-theme='light'] .timeline-content li::before { color: #28A745; }
        :root[data-theme='light'] .timeline-content li strong { color: #28A745; }
        :root[data-theme='light'] .ask-item {
            background: rgba(40, 167, 69, 0.05);
            border-color: rgba(40, 167, 69, 0.2);
        }
        :root[data-theme='light'] .ask-label { color: #28A745; }
        :root[data-theme='light'] .ask-value { color: #212529; }
        :root[data-theme='light'] .closing-quote { color: #212529; }
        :root[data-theme='light'] .closing-author { color: #28A745; }
        :root[data-theme='light'] .cta-button.primary { background: #28A745; color: white; }
        :root[data-theme='light'] .cta-button.secondary { border-color: #28A745; color: #28A745; }
        :root[data-theme='light'] .cta-note { color: #6C757D; }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .proposal-page { padding: 100px 1rem 3rem; }
            .proposal-section { padding: 2rem 1.5rem; }
            .profile-grid, .ask-grid { grid-template-columns: 1fr; }
            .profile-stats { grid-template-columns: 1fr 1fr; }
            .timeline-item { flex-direction: column; gap: 0.75rem; }
        }
    </style>
</Layout>
