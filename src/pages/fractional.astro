---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import WindowFrameLog from '../components/WindowFrameLog.tsx';
import FractionalShowcase from '../components/FractionalShowcase.tsx';

const CALL = 'https://cal.com/mad-ez-media/ai-automation-discovery';
---

<Layout
    title="Fractional CTO & Head of AI | Mikey Shaw"
    description="Fractional CTO, Head of AI, and AI Systems Architect. Production multi-agent systems, LogMem shared memory, Voice AI, and revenue automation. Charlotte, NC · Remote-first."
>
    <Navbar />

    <main class="w-full">
        <!-- Hero -->
        <section class="max-w-[1440px] mx-auto px-6 md:px-[60px] pt-36 pb-16">
            <div class="max-w-4xl">
                <div class="ms-label mb-4 text-[var(--ms-accent-text)]">
                    Fractional CTO · Head of AI · AI Systems Architect · Charlotte, NC · Remote-first
                </div>
                <h1
                    class="m-0 text-[clamp(2.5rem,5.4vw,4.75rem)] font-black leading-[1.02] tracking-tight text-[var(--ms-text)]"
                    style="font-family: var(--ms-font-head)"
                >
                    Operator first, technologist <em class="italic text-[var(--ms-accent-text)]">second.</em>
                </h1>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--ms-muted)]">
                    I build AI agent systems that do real jobs: answering, booking, following up, and remembering. I run them in production for my own businesses before I ever sell them to yours.
                </p>
                <div class="mt-8 flex flex-wrap items-center gap-4">
                    <a class="ms-btn" href={CALL} target="_blank" rel="noopener noreferrer">Book 30-min discovery →</a>
                    <a
                        class="inline-flex min-h-[44px] items-center rounded-[var(--ms-r-button)] border-2 border-[var(--ms-text)] px-5 font-sans text-xs font-bold uppercase tracking-[0.1em] text-[var(--ms-text)] no-underline hover:bg-[var(--ms-surface)]"
                        href="#rates"
                    >
                        Jump to rate card
                    </a>
                    <a
                        class="font-sans text-sm font-bold text-[var(--ms-text)] underline decoration-[var(--ms-ember)] decoration-2 underline-offset-4 hover:text-[var(--ms-accent-text)]"
                        href="/resume"
                    >
                        Full resume →
                    </a>
                </div>
            </div>
        </section>

        <!-- Rates + Audience Switcher + Proof Assets -->
        <section class="border-t border-[var(--ms-border)] bg-[var(--ms-surface)]" id="rates">
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-20">
                <FractionalShowcase client:load defaultAudience="fractional" callUrl={CALL} />
            </div>
        </section>

        <!-- Live Sample Log -->
        <section class="border-t border-[var(--ms-border)]">
            <div class="max-w-[1440px] mx-auto px-6 md:px-[60px] py-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-5">
                    <span class="ms-label text-[var(--ms-accent-text)]">Governance by Design</span>
                    <h2
                        class="mt-3 mb-4 text-[clamp(1.9rem,3.6vw,3rem)] font-black leading-[1.06] text-[var(--ms-text)]"
                        style="font-family: var(--ms-font-head)"
                    >
                        Every action logged. Every spend <em class="italic text-[var(--ms-accent-text)]">approved.</em>
                    </h2>
                    <p class="text-base leading-relaxed text-[var(--ms-muted)]">
                        Weekly demos over status decks. Approval gates on anything that sends, spends, or deletes. Written records for every decision so founders and engineers can audit any agent run in seconds.
                    </p>
                </div>
                <div class="lg:col-span-7">
                    <WindowFrameLog />
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section class="border-t border-[var(--ms-border)] bg-[var(--ms-surface)] px-6 md:px-[60px] py-20">
            <div class="max-w-[1440px] mx-auto">
                <ContactSection />
            </div>
        </section>
    </main>

    <Footer
        copyright="© 2026 Mikey Shaw · Mad EZ Media Partners LLC."
        links={[
            { label: 'Home', href: '/' },
            { label: 'Mad EZ Media', href: 'https://madezmedia.com' },
            { label: 'LogMem', href: 'https://logmem.si' },
            { label: 'Resume', href: '/resume' },
        ]}
    />
</Layout>
