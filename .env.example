# ==============================================================================
# Webmaster, Analytics & Tag Manager (Public client-side IDs — safe in Vercel)
# Leave any variable blank to keep its tag completely disabled.
# ==============================================================================

# Google Tag Manager (recommended master container for GA4, LinkedIn, Meta, Ads)
PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Loaded directly ONLY when PUBLIC_GTM_ID is blank (or set PUBLIC_GA4_DIRECT=true)
# so GA4 pageviews are never double-counted when managed inside GTM.
PUBLIC_GA4_ID=
PUBLIC_GA4_DIRECT=false

# Search Engine Webmaster Verification Codes (content value only, not full meta tag)
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_AHREFS_VERIFICATION=

# Optional Behavioral / B2B Attribution Tags
PUBLIC_CLARITY_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_META_PIXEL_ID=
